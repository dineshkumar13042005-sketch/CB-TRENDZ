# CB TRENDZ — Payment Gateway & Server Environment Configuration
PORT=5000

# Cashfree Payments Credentials (Get these from https://merchant.cashfree.com/)
# For Sandbox Testing: Use Test App ID (starts with TEST...) and Secret Key from Developers > API Keys
CASHFREE_APP_ID=YourCashfreeAppId
CASHFREE_SECRET_KEY=YourCashfreeSecretKey
# Environment: 'TEST' for Cashfree Sandbox, 'PRODUCTION' for Live Payments
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# Razorpay Credentials (Optional fallback)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Store Details
STORE_NAME=CB TRENDZ
STORE_PHONE=918778522690
